rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'rh8WrITlLTXrsDj5mbJHzA1D4Bk2';
    }

    match /premiumProfiles/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'lastSeenAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'lastSeenAt']);
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow delete: if false;
    }

    match /premiumEntitlements/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /premiumAuditLog/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /releaseEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId}/releaseEvents/{eventId} {
      allow read, delete: if signedIn()
        && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId}/releaseReminders/{reminderId} {
      allow read, delete: if signedIn()
        && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'eventId', 'eventScope', 'eventName', 'siteName',
          'siteUrl', 'eventStartsAt', 'timeZone', 'remindAt', 'minutesBefore',
          'notificationVersion', 'status',
          'attempts', 'sentAt', 'scheduledAt', 'scheduledFor',
          'oneSignalMessageId', 'cancelMessageId', 'lastError', 'updatedAt'
        ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
